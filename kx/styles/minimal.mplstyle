# light without the box: no spines or tick marks, a light grid along the values only (x for barh, lollipop, imp)
figure.facecolor: FFFFFF
axes.facecolor:   FFFFFF
text.color:       222222
axes.labelcolor:  222222
xtick.color:      444444
ytick.color:      444444
axes.edgecolor:   BBBBBB
axes.spines.left:   False
axes.spines.bottom: False
axes.spines.top:    False
axes.spines.right:  False
axes.grid:        True
axes.grid.axis:   y
axes.axisbelow:   True
grid.color:       E5E5E5
xtick.major.size: 0
ytick.major.size: 0
xtick.minor.size: 0
ytick.minor.size: 0
axes.prop_cycle:  cycler('color', ['1F77B4', 'FF7F0E', '2CA02C', 'D62728', '9467BD'])
figure.figsize:   8, 4.5
figure.dpi:       110
font.size:        11
legend.frameon:   False
lines.linewidth:  2
