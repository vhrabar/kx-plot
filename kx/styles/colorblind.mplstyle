# light with Okabe-Ito without the yellow, hard to see on white: blue, orange, green,
# vermillion, sky, purple, black, each with its own linestyle so lines differ for every colour-vision deficiency
# and in greyscale. Colours: Okabe & Ito (2008), https://jfly.uni-koeln.de/color/ (see palettes/LICENCES.md)
figure.facecolor: FFFFFF
axes.facecolor:   FFFFFF
text.color:       222222
axes.labelcolor:  222222
xtick.color:      444444
ytick.color:      444444
axes.edgecolor:   BBBBBB
grid.color:       E5E5E5
axes.spines.top:  False
axes.spines.right: False
axes.prop_cycle:  cycler('color', ['0072B2', 'E69F00', '009E73', 'D55E00', '56B4E9', 'CC79A7', '000000']) + cycler('linestyle', ['-', '--', ':', '-.', '-', '--', ':'])
image.cmap:       cividis
figure.figsize:   8, 4.5
figure.dpi:       110
font.size:        11
legend.frameon:   False
lines.linewidth:  2
